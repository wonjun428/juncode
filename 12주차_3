%% 3번 문제
clear; clc;

%% (a) 익명 함수(Anonymous Function) f를 정의하시오.
f = @(v) (v(1) - 3).^2 + 2*(v(2) + 1).^4 + 5;

fprintf('--- (a) 익명 함수 f(x,y) 정의 완료 ---\n');
disp(f);

%% (b) 초기 추정값 [x0, y0] = [0, 0]에서 시작하여 최솟값을 계산하시오.
v0 = [0, 0];
[v_opt, f_val] = fminsearch(f, v0);

x_opt = v_opt(1);
y_opt = v_opt(2);

fprintf('--- (b) 최적화 결과 (최솟값 및 최적점) ---\n');
fprintf('최적점의 x 좌표 (x_opt) : %.4f\n', x_opt);
fprintf('최적점의 y 좌표 (y_opt) : %.4f\n', y_opt);
fprintf('함수의 최솟값 (f_val)   : %.4f\n\n', f_val);

%% (c) 최적점 주변의 범위를 설정하여 수식의 surface(곡면) 그래프를 그리시오.
[X, Y] = meshgrid(1:0.1:5, -3:0.1:1);

Z = (X - 3).^2 + 2*(Y + 1).^4 + 5;

figure;
surf(X, Y, Z);
colorbar;
hold on;

plot3(x_opt, y_opt, f_val, 'r*', 'MarkerSize', 12, 'LineWidth', 2);
hold off;

grid on;
title('Objective Function Surface and Optimal Point');
xlabel('x');
ylabel('y');
zlabel('f(x, y)');
legend('Objective Function f(x,y)', 'Optimal Point (Minimum)', 'Location', 'best');
