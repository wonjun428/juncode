%% 11번 문제
clear; clc;

% (a) t = linspace(0,80,12000)을 생성하시오.
t = linspace(0, 80, 12000);

% (b) 함수값을 y에 저장하시오. 
y = exp(-0.04*t) .* sin(2*t) + 0.3*exp(-0.01*t) .* cos(7*t);

% (c) figure('Color','w')를 사용하여 흰 배경의 figure를 생성하시오.
fig = figure('Color', 'w'); 

% (d) plot을 이용하여 y를 선 두께 1.3 이상으로 나타내시오.
plot(t, y, 'b-', 'LineWidth', 1.5);
hold on;

% (e) yline(0)을 추가하여 기준선을 표시하시오.
yline(0, '--k', 'LineWidth', 1.0);
hold off;

% (f) x축 label, y축 label, 제목을 설정하시오.
xlabel('Time');
ylabel('Signal Amplitude');
title('High-Resolution Damped Oscillatory Signal');

% (g) xlim([0 80]), grid on, box on을 적용하시오.
xlim([0, 80]);
grid on;
box on;

% (h) 축 글꼴 크기를 12 이상으로 설정하고 축 선 두께를 1.2 이상으로 설정하시오.
ax = gca;
ax.FontSize = 12;
ax.LineWidth = 1.2;

% (i) 최종 figure를 damped_signal.png라는 이름으로 300 dpi PNG 파일로 저장하시오.
exportgraphics(fig, 'damped_signal.png', 'Resolution', 300);
