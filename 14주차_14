%% 14번 문제
clear; clc;

% (a) x, y를 각각 [-4, 4] 구간에서 300개의 점으로 생성하시오.
x = linspace(-4, 4, 300);
y = linspace(-4, 4, 300);

% (b) meshgrid를 이용하여 X, Y를 생성하시오.
[X, Y] = meshgrid(x, y);

% (c) Z1, Z2, Z3를 각각 계산하시오. (원소별 연산자 .*, .^ 필수 적용)
Z1 = sin(X) .* cos(Y);
Z2 = exp(-0.08 * (X.^2 + Y.^2));
Z3 = sin(X.^2 + Y.^2);

% (d) tiledlayout(1,3)을 사용하여 1행 3열 레이아웃을 생성하시오.
figure;
t = tiledlayout(1, 3); 

% (h) 전체 제목은 'Comparison of Three Surface Structures'로 설정하시오.
title(t, 'Comparison of Three Surface Structures');

% Tile 1: 주기적 진동 (Z1)
nexttile;
surf(X, Y, Z1);
shading interp; % (f) shading interp 포함
colorbar;       % (f) colorbar 포함
xlabel('X'); ylabel('Y'); zlabel('Z'); % (f) 축 label 포함
title('Periodic Oscillation (Z1)');   % (f) 개별 제목 포함
view(45, 30);   % (g) view(45, 30) 적용

% Tile 2: 중심부 집중 (Z2)
nexttile;
surf(X, Y, Z2);
shading interp; % (f) shading interp 포함
colorbar;       % (f) colorbar 포함
xlabel('X'); ylabel('Y'); zlabel('Z'); % (f) 축 label 포함
title('Central Concentration (Z2)');  % (f) 개별 제목 포함
view(45, 30);   % (g) view(45, 30) 적용

% Tile 3: 원형 파동 구조 (Z3)
nexttile;
surf(X, Y, Z3);
shading interp; % (f) shading interp 포함
colorbar;       % (f) colorbar 포함
xlabel('X'); ylabel('Y'); zlabel('Z'); % (f) 축 label 포함
title('Circular Wave Structure (Z3)'); % (f) 개별 제목 포함
view(45, 30);   % (g) view(45, 30) 적용
