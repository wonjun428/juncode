%% 12번 문제
clear; clc;

% (a) x, y를 각각 [-5, 5] 구간에서 600개의 점으로 생성하시오.
x = linspace(-5, 5, 600);
y = linspace(-5, 5, 600);

% (b) meshgrid를 이용하여 X, Y를 생성하시오.
[X, Y] = meshgrid(x, y);

% (c) 원소별 연산을 사용하여 Z를 계산하시오.
Z = exp(-0.06 * (X.^2 + Y.^2)) .* sin(4*X) .* cos(3*Y) + 0.2 * sin(X.*Y);

% (d) surf(X,Y,Z)를 이용하여 surface 그래프를 그리시오.
figure;
surf(X, Y, Z);

% (e) shading interp, colormap(jet), colorbar를 적용하시오.
shading interp;
colormap(jet);
colorbar;

% (f) x축 label, y축 label, z축 label을 각각 'X', 'Y', 'Z'로 지정하시오.
xlabel('X');
ylabel('Y');
zlabel('Z');

% (g) 제목은 'Detailed Surface Plot with Oscillation and Damping'으로 지정하시오.
title('Detailed Surface Plot with Oscillation and Damping');

% (h) view(45,30), camlight headlight, lighting phong을 적용하시오.
view(45, 30);
camlight headlight;
lighting phong;

% (i) max(Z(:)), min(Z(:))을 이용하여 최대값과 최소값을 각각 maxZ, minZ에 저장하시오.
maxZ = max(Z(:));
minZ = min(Z(:));

% (j) 최대값과 최소값이 발생하는 위치의 (x, y, z) 좌표를 각각 maxPoint, minPoint에 저장하시오.
% 1. 최댓값 위치 인덱스 찾기
[~, maxIdx] = max(Z(:));
% 2. 최솟값 위치 인덱스 찾기
[~, minIdx] = min(Z(:));

% 1차원 선형 인덱스를 2차원 행렬의 [행, 열] 인덱스로 변환 (ind2sub 함수 활용)
[maxRow, maxCol] = ind2sub(size(Z), maxIdx);
[minRow, minCol] = ind2sub(size(Z), minIdx);

maxPoint = [X(maxRow, maxCol), Y(maxRow, maxCol), Z(maxRow, maxCol)];
minPoint = [X(minRow, minCol), Y(minRow, minCol), Z(minRow, minCol)];
