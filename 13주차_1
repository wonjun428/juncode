%% 1번 문제

%% (a) rng(13)을 사용하여 seed를 고정하시오.
rng(13);

%% (b) rand를 이용하여 40개 문항의 정답 확률 p_i를 생성하시오.
p = 0.35 + (0.95 - 0.35) * rand(1, 40);

%% (c) 5000명의 학생에 대해 각 문항의 정답 여부를 5000 x 40 logical matrix로 생성하시오.
scores_matrix = rand(5000, 40) <= p;

%% (d) 각 학생의 총점, 평균점수, 표준편차를 계산하시오.
total_scores = sum(scores_matrix, 2); 

mean_score = mean(total_scores);
std_score = std(total_scores);

fprintf('--- 시험 결과 요약 ---\n');
fprintf('학생들의 평균 점수: %.2f점\n', mean_score);
fprintf('학생들의 점수 표준편차: %.2f\n', std_score);
fprintf('----------------------\n\n');

%% (e) 점수 histogram을 그리고, 평균점수 이상인 학생의 비율을 계산하시오.

figure;
histogram(total_scores, 'BinWidth', 1, 'FaceColor', [0.2 0.6 0.8], 'EdgeColor', 'w');
grid on;
title('학생 5000명의 시험 점수 분포 (Histogram)');
xlabel('총점 (40점 만점)');
ylabel('학생 수 (명)');

above_mean_ratio = sum(total_scores >= mean_score) / 5000;

fprintf('평균점수(%.2f점) 이상인 학생의 비율: %.2f%%\n', mean_score, above_mean_ratio * 180 / 1.8);
