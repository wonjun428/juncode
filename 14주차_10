%% 10번 문제
clear; clc;

% (a) 관측 시각을 tObs, 관측 농도를 cObs에 저장하시오.
tObs = [0, 1.2, 2.8, 4.5, 7.0, 8.1, 9.7, 12.0];
cObs = [5.0, 6.4, 9.1, 8.6, 6.8, 5.9, 5.2, 4.8];

% (b) tq = 0:0.1:12를 생성하시오.
tq = 0:0.1:12;

% (c) 선형보간을 이용하여 cqLinear를 생성하시오.
cqLinear = interp1(tObs, cObs, tq, 'linear');

% (d) 스플라인 보간을 이용하여 cqSpline을 생성하시오.
cqSpline = interp1(tObs, cObs, tq, 'spline');

% (e) 선형보간 결과에 대해 인접한 농도 차이 deltaC = diff(cqLinear)를 계산하시오.
deltaC = diff(cqLinear);

% (f) abs(deltaC)가 가장 큰 위치의 index를 idxMaxChange에 저장하시오.
[~, idxMaxChange] = max(abs(deltaC));

% (g) idxMaxChange에 해당하는 시간 구간 [tq(idxMaxChange), tq(idxMaxChange + 1)]을 changeInterval에 저장하시오.
changeInterval = [tq(idxMaxChange), tq(idxMaxChange + 1)];

% (h) 관측 데이터, 선형보간 결과, 스플라인 보간 결과를 하나의 그래프에 나타내고, 
figure;

% 1. 선형 보간 결과 (파란색 점선)
plot(tq, cqLinear, 'b--', 'LineWidth', 1.2);
hold on;

% 2. 스플라인 보간 결과 (녹색 실선)
plot(tq, cqSpline, 'g-', 'LineWidth', 1.2);

% 3. 원본 관측 데이터 (검은색 사각형 마커)
plot(tObs, cObs, 'ks', 'MarkerSize', 6, 'MarkerFaceColor', 'k');

% 4. 변화가 가장 큰 구간의 두 끝점을 큼직한 빨간색 원 마커('ro')로 강조 표시
x_points = [tq(idxMaxChange), tq(idxMaxChange + 1)];
y_points = [cqLinear(idxMaxChange), cqLinear(idxMaxChange + 1)];
plot(x_points, y_points, 'ro', 'MarkerSize', 9, 'MarkerFaceColor', 'r');

hold off;

title('Concentration Change and Steepest Interval Analysis');
xlabel('Time');
ylabel('Concentration');
legend('Linear Interpolation', 'Spline Interpolation', 'Observed Data', 'Max Change Interval', 'Location', 'best');
grid on;
