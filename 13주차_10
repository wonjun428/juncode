%% 10번 문제
clear; clc;

num_days = 10000;
base_power = 500;
server_mu = 0;
server_sigma = 35;
overload_prob = 0.12;
overload_power = 120;

%% (a) 서버 부하 변동을 randn으로 생성하시오.
server_flux = server_mu + server_sigma * randn(num_days, 1);

%% (b) 냉각장치 과부하 여부를 rand와 logical condition으로 생성하시오.
is_overloaded = rand(num_days, 1) <= overload_prob;

%% (c) 하루 전력 사용량을 계산하시오.
total_power = base_power + server_flux + (is_overloaded * overload_power);

%% (d) 전력 사용량이 650을 초과하는 날의 비율을 계산하시오.
exceed_650_ratio = sum(total_power > 650) / num_days;

mean_overload = mean(total_power(is_overloaded));
mean_normal = mean(total_power(~is_overloaded));

fprintf('--- 데이터센터 전력 시뮬레이션 결과 ---\n');
fprintf('전력 사용량이 650을 초과하는 날의 비율: %.2f%%\n', exceed_650_ratio * 100);
fprintf('과부하 발생일의 평균 전력 사용량: %.2f\n', mean_overload);
fprintf('과부하 비발생일의 평균 전력 사용량: %.2f\n', mean_normal);
fprintf('---------------------------------------\n\n');

%% (e) 전체 전력 사용량 histogram을 그리고, 평균 전력 사용량을 각각 출력하시오.
figure;
histogram(total_power, 'FaceColor', [0.1 0.5 0.7], 'EdgeColor', 'w');

grid on;
title('10,000일 동안의 데이터센터 하루 전력 사용량 분포');
xlabel('하루 전력 사용량');
ylabel('일수 (일)');
