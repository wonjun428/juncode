%% 11번 문제
clear; clc;

%% (a) 행렬 A를 생성하시오.
A = [ 3, -1,  5, -2,  4;
     -4,  6, -3,  2,  1;
      7, -5,  8, -1,  0;
     -2,  4, -6,  9,  3;
      5, -3,  2, -4,  6];

%% (b) 원본 행렬 A를 복사하여 A_clean을 생성하시오.
A_clean = A;

%% (c) 중첩 for문을 사용하여 A_clean의 모든 원소를 검사하시오.
% (d) 검사 중 원소가 음수이면 해당 원소를 0으로 변경하시오.
[rows, cols] = size(A_clean);

for i = 1:rows
    for j = 1:cols
        
        if A_clean(i, j) < 0
            A_clean(i, j) = 0;
        end
        
    end
end

%% (e) 정제 전후를 비교하기 위해 A와 A_clean을 모두 출력하시오.
fprintf('=========================================\n');
fprintf('         [11번 문제 결과 보고서]         \n');
fprintf('=========================================\n\n');

fprintf('--- (e) 정제 전 원본 행렬 A ---\n');
disp(A);

fprintf('--- (e) 정제 후 필터 행렬 A_clean (음수 제거) ---\n');
disp(A_clean);
