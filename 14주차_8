%% 8번 문제
clear; clc;

% (a) 관측 시각을 timeObs, 관측 풍속을 windObs에 저장하시오.
timeObs = [0, 3, 6, 9, 12, 15, 18, 21, 24];
windObs = [3.1, 3.8, 5.4, 7.2, 8.0, 7.1, 5.6, 4.2, 3.5];

% (b) 0부터 24까지 1시간 간격의 벡터 timeHourly를 생성하시오.
timeHourly = 0:24;

% (c) interp1을 이용하여 선형 보간 결과를 windLinear에 저장하시오.
windLinear = interp1(timeObs, windObs, timeHourly, 'linear');

% (d) interp1을 이용하여 스플라인 보간 결과를 windSpline에 저장하시오.
windSpline = interp1(timeObs, windObs, timeHourly, 'spline');

% (e) 두 보간 결과의 차이 diffWind = windSpline - windLinear를 계산하시오.
diffWind = windSpline - windLinear;

% (f) abs(diffWind)의 최대값을 maxDiff에 저장하시오.
maxDiff = max(abs(diffWind));

% (g) 관측 데이터, 선형 보간 결과, 스플라인 보간 결과를 하나의 그래프에 나타내시오.
figure;

plot(timeHourly, windLinear, 'b--', 'LineWidth', 1.2);
hold on;
plot(timeHourly, windSpline, 'g-', 'LineWidth', 1.2);

plot(timeObs, windObs, 'ro', 'MarkerSize', 6, 'MarkerFaceColor', 'r');
hold off;

title('Wind Speed Interpolation Comparison');
xlabel('Time (Hours)');
ylabel('Wind Speed');
legend('Linear Interpolation', 'Spline Interpolation', 'Observed Data', 'Location', 'best');
grid on;

% (h) 별도의 figure에 diffWind를 선 그래프로 나타내시오.
figure;
plot(timeHourly, diffWind, 'm-', 'LineWidth', 1.5);


title('Difference between Spline and Linear Interpolation (diffWind)');
xlabel('Time (Hours)');
ylabel('Difference (Spline - Linear)');
grid on;
